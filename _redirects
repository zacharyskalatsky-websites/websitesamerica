# Internal repo files must not be publicly served (ZV1 Security Standard).
# Cloudflare Pages ignores a 404 status in _redirects, so each rule rewrites (200) to a path that does not exist, which returns the real 404 page.
/CLAUDE.md /no-such-page 200
/SECURITY.md /no-such-page 200
/README.md /no-such-page 200
/.gitignore /no-such-page 200
/.claude/* /no-such-page 200
